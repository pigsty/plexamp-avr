[plexamp-avr]
plexamp_host = localhost
plexamp_port = 32500
avr_host = 192.168.1.100
avr_port = 23
avr_input = MEDIA PLAYER
off_timer_seconds = 900
# Leave empty to keep the AVR's current volume.
preset_volume = 60
power_on_delay_seconds = 5.0
request_timeout_seconds = 5.0
# Optional webhooks called when the idle (standby) timer starts and when it expires.
# Resuming playback before the timer expires does not call any webhook.
# Leave empty to disable. The payload is JSON (omitted for GET).
idle_timer_start_webhook_url =
idle_timer_expired_webhook_url =
webhook_method = POST
