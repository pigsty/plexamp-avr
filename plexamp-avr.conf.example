[plexamp-avr]
plexamp_host = localhost
plexamp_port = 32500
avr_host = 192.168.1.100
avr_port = 23
avr_input = MEDIA PLAYER
off_timer_seconds = 900
# Leave empty to keep the AVR's current volume.
preset_volume = 60
power_on_delay_seconds = 5.0
request_timeout_seconds = 5.0
# Web UI and HTTP API (no authentication; only expose on trusted networks).
web_enabled = true
web_host = 0.0.0.0
web_port = 8080
# Comma-separated inputs offered in the web UI. Leave empty for the defaults.
avr_inputs =
